# Thư mục chứa Chrome profile đã đăng nhập Apollo (tạo bằng `npm run apollo:login`)
CHROME_USER_DATA_DIR=./.chrome-profile

# Thư mục chứa Chrome profile RIÊNG đã đăng nhập Teams + Gmail (tạo bằng `npm run risky:login`) —
# TÁCH BIỆT với profile Apollo ở trên, để hàng đợi xử lý Risky (Teams/Gmail -> meetscript.io) chạy
# ĐỒNG THỜI được với hàng đợi Apollo/Debounce (2 Chrome mở cùng 1 profile sẽ tranh khoá và crash
# nhau — đây chính là lý do phải tách riêng). BẮT BUỘC chạy `npm run risky:login` 1 lần trước khi
# dùng, vì profile mới này KHÔNG có sẵn session Teams/Gmail từ profile Apollo cũ.
RISKY_CHROME_USER_DATA_DIR=./.chrome-profile-risky

# true = chạy ẩn (headless). Apollo có bot-detection khá chặt, khuyến nghị để false
# và chạy trong Xvfb (xem README) thay vì bật headless thật, để giảm khả năng bị chặn.
HEADLESS=false

# API key lấy tại app.debounce.io > Settings > API
DEBOUNCE_API_KEY=

# Đường dẫn tới file JSON key của Google service account (xem README phần Google Drive)
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json

# ID của folder Google Drive để upload file "Safe to Send"
# (lấy từ URL folder: drive.google.com/drive/folders/<ID_NÀY>)
GDRIVE_SAFE_TO_SEND_FOLDER_ID=

# IP công khai của server này — dùng để host tạm file CSV cho Debounce tải về (xem README).
PUBLIC_HOST=103.252.122.224

# Port mở tạm để host file CSV — nhớ mở port này trên firewall VM (sudo ufw allow <port>).
FILE_SERVE_PORT=8443

# Mật khẩu đăng nhập web UI (npm run web) — BẮT BUỘC nên đặt vì VM có IP công khai, để trống thì
# ai biết IP:port cũng chạy được luồng (tốn tiền Apollo/Debounce thật). Team chỉ cần nhập mật khẩu
# này 1 lần khi trình duyệt hỏi (không cần tên đăng nhập).
WEBUI_PASSWORD=

# Port chạy web UI — mặc định chỉ lắng nghe localhost (xem WEBUI_HOST), nên KHÔNG cần mở trên
# firewall nữa khi đã setup Caddy đứng trước (xem README phần "Chạy qua Web UI" > HTTPS qua Caddy).
WEBUI_PORT=8090

# Web UI lắng nghe trên địa chỉ nào — để mặc định "127.0.0.1" (chỉ máy này gọi được), vì Caddy
# (reverse proxy lo HTTPS thật) sẽ là cổng public duy nhất. Chỉ đổi thành "0.0.0.0" nếu CHƯA setup
# Caddy và chấp nhận dùng tạm qua http:// (không mã hoá, xem README).
WEBUI_HOST=127.0.0.1

# Theo dõi kết quả Risky (file Team/Google) mà bot meetscript.io gửi vào group Telegram chung của
# team, và gửi lại file Excel gốc đã cập nhật vào group đó — để trống TELEGRAM_BOT_TOKEN hoặc
# TELEGRAM_CHAT_ID thì tính năng GỬI LẠI tự tắt, không ảnh hưởng phần còn lại.
#
# Cách lấy:
#   1. Chat với @BotFather trên Telegram, gõ /newbot, đặt tên bất kỳ -> nhận về BOT TOKEN.
#   2. Thêm bot này vào ĐÚNG group Telegram mà bot meetscript.io đang gửi kết quả vào (bot chỉ
#      dùng để GỬI file kết quả cuối cùng lại group, không dùng để "nghe" nữa — xem phần
#      TELEGRAM_API_ID/TELEGRAM_USER_SESSION bên dưới).
#   3. Gửi 1 tin nhắn bất kỳ trong group đó, rồi chạy lệnh sau (thay <TOKEN> bằng token ở bước 1)
#      để xem CHAT ID của group (số âm, kiểu "-1001234567890", nằm trong "chat":{"id": ...}):
#        curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Username (không cần dấu "@") của CHÍNH bot meetscript.io trong group đó — dùng để kiểm tra đúng
# người gửi file, tránh nhận nhầm nếu ai khác trong group lỡ gửi trùng tên file. Cách tìm: trong
# Telegram, bấm vào tên/avatar của bot meetscript.io trong group -> xem username hiện ở đó.
# Để trống vẫn chạy được nhưng KHÔNG an toàn (chỉ dựa vào tên file, không kiểm tra người gửi).
TELEGRAM_RESULT_BOT_USERNAME=

# Sau ngần ấy phút chưa thấy bot trả kết quả cho 1 file, web UI sẽ hiện CẢNH BÁO (không tự bỏ theo
# dõi — vẫn tự động nhận nếu bot trả về muộn hơn). Mặc định 90 phút theo mức tối đa đã xác nhận
# thực tế cho 1 file; có thể tăng nếu hay thấy cảnh báo "chờ quá lâu" mà thực ra sau đó bot vẫn trả
# về bình thường (vd do xử lý nhiều file song song khiến backend meetscript.io chậm hơn).
TELEGRAM_RESULT_WARN_AFTER_MINUTES=90

# ⚠️ QUAN TRỌNG — đã xác nhận thực tế: Telegram KHÔNG BAO GIỜ cho bot của mình (TELEGRAM_BOT_TOKEN
# ở trên) thấy tin nhắn do MỘT BOT KHÁC gửi trong group (giới hạn cố định của Telegram, không có
# cách bật lại, không liên quan gì tới cấu hình/mạng) — mà bot meetscript.io gửi kết quả CŨNG LÀ 1
# bot, nên bot của mình không bao giờ "nghe" được nó. Vì vậy việc NGHE group bắt buộc phải dùng 1
# TÀI KHOẢN NGƯỜI THẬT (qua giao thức MTProto) — tài khoản người thật thì thấy tin nhắn của MỌI bot
# trong group bình thường. Bot ở trên (TELEGRAM_BOT_TOKEN) vẫn giữ lại, chỉ dùng để GỬI LẠI file đã
# cập nhật vào group.
#
# Cách lấy TELEGRAM_API_ID/TELEGRAM_API_HASH:
#   1. Vào https://my.telegram.org, đăng nhập bằng SĐT của tài khoản SẼ DÙNG để theo dõi group
#      (có thể dùng tài khoản cá nhân, hoặc tạo 1 tài khoản Telegram phụ riêng cho việc này).
#      QUAN TRỌNG: tài khoản này phải đã ở trong group mà bot meetscript.io gửi kết quả vào.
#   2. Vào mục "API development tools", tạo 1 app bất kỳ (tên/mô tả gì cũng được) -> nhận về
#      "App api_id" và "App api_hash", điền vào 2 dòng dưới.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Chuỗi phiên đăng nhập (session) của tài khoản người thật ở trên — KHÔNG tự điền tay được, phải
# chạy lệnh sau 1 LẦN DUY NHẤT (sau khi đã điền TELEGRAM_API_ID/TELEGRAM_API_HASH ở trên) rồi copy
# kết quả in ra dán vào đây:
#   npm run telegram:login
# Lệnh này sẽ hỏi số điện thoại + mã OTP Telegram gửi về (giống đăng nhập Telegram bình thường).
# Đăng nhập xong KHÔNG cần lặp lại nữa — service tự dùng chuỗi này để kết nối lại mỗi lần khởi động.
# Giữ bí mật chuỗi này (tương đương mật khẩu đăng nhập tài khoản Telegram đó).
TELEGRAM_USER_SESSION=
